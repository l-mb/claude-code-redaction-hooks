{
  "session_id": "<SESSION>",
  "transcript_path": "<HOME>/.claude/projects/-<PROJECT>/<SESSION>.jsonl",
  "cwd": "<HOME>/<PROJECT>",
  "permission_mode": "auto",
  "effort": {"level": "high"},
  "hook_event_name": "PostToolUse",
  "tool_name": "Grep",
  "tool_input": {
    "pattern": "rules",
    "path": "<HOME>/<PROJECT>"
  },
  "tool_response": {
    "filenames": [
      "<HOME>/<PROJECT>/README.md",
      "<HOME>/<PROJECT>/.redaction_rules"
    ],
    "mode": "files_with_matches",
    "numFiles": 2
  },
  "tool_use_id": "<TOOL_USE>",
  "duration_ms": 6
}
